---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Marquee from '~/components/Marquee.astro';
---

<BaseLayout
  title="Membership"
  description="Carpet Club membership unlocks discounted tickets at every event. One-time enrolment via Shotgun during any Wednesday Room night."
>
  <section class="membership-section">
    <header class="section-header">
      <p class="section-label">Join the Family</p>
      <h1>Membership</h1>
      <p class="lede">
        Carpet Club members always get access to cheaper ticket prices at our events.
        No subscription, no monthly fees — just a one-time enrolment that unlocks
        discounts at every future Carpet Club event.
      </p>
    </header>

    <div class="grid">
      <div class="perks-card">
        <p class="card-label">Member Perks</p>
        <ul role="list" class="perks-list">
          <li>Discounted tickets at all Carpet Club events</li>
          <li>Priority access to limited releases and special nights</li>
          <li>Part of the official Carpet Club member list</li>
        </ul>
      </div>

      <div class="how-card">
        <p class="card-label">How to Join</p>
        <p>
          During any of our Wednesday Room nights, select the
          <strong>"Ticket + New Member Request"</strong> option on Shotgun.
          Your first visit enrols you — every future event, you pay the member price.
        </p>
        <a
          href="https://shotgun.live/en/venues/carpet-snares-records"
          target="_blank"
          rel="noopener noreferrer"
          class="cta"
          data-drip
          data-drip-intensity="28"
        >
          Become a Member →
        </a>
        <p class="note">Available on Shotgun only</p>
      </div>
    </div>
  </section>

  <Marquee />
</BaseLayout>

<style>
  .membership-section {
    padding: 140px 48px 96px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-header { margin-bottom: 64px; max-width: 720px; }
  .section-label {
    font-family: theme('fontFamily.mono');
    font-size: 9px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: theme('colors.accent.DEFAULT');
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1;
    margin-bottom: 24px;
  }
  .lede {
    color: theme('colors.text.DEFAULT');
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .perks-card, .how-card {
    background: theme('colors.bg.card');
    border: 1px solid theme('colors.border');
    padding: 40px;
    border-radius: 2px;
  }
  .card-label {
    font-family: theme('fontFamily.mono');
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: theme('colors.accent.DEFAULT');
    margin-bottom: 24px;
  }
  .perks-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .perks-list li {
    position: relative;
    padding-left: 24px;
    line-height: 1.6;
  }
  .perks-list li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: theme('colors.accent.DEFAULT');
  }
  .how-card p {
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .how-card strong { color: theme('colors.accent.DEFAULT'); }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 28px;
    background: theme('colors.accent.DEFAULT');
    color: theme('colors.bg.DEFAULT');
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.2s;
  }
  .cta:hover { background: theme('colors.accent.hover'); transform: translateY(-2px); }
  .note {
    margin-top: 12px;
    font-family: theme('fontFamily.mono');
    font-size: 10px;
    letter-spacing: 2px;
    color: theme('colors.text.muted');
  }

  @media (max-width: 700px) {
    .membership-section { padding: 100px 24px 64px; }
    .grid { grid-template-columns: 1fr; }
    .perks-card, .how-card { padding: 28px; }
  }
</style>
