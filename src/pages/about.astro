---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Marquee from '~/components/Marquee.astro';
import { getCollection } from 'astro:content';

const artists = await getCollection('artists');
---

<BaseLayout
  title="About"
  description="Carpet Club is a Lisbon-based event brand. Weekly events and curated showcases rooted in electronic music and club culture, part of the Carpet & Snares ecosystem (est. 2014)."
>
  <section class="about-section">
    <header class="section-header">
      <p class="section-label">About</p>
      <h1>Lisbon, built on Wednesdays.</h1>
    </header>

    <div class="about-body">
      <p>
        Carpet Club is a Lisbon-based event brand. We run weekly events and curated
        showcases rooted in electronic music and club culture, as part of the
        Carpet &amp; Snares ecosystem (est. 2014).
      </p>
      <p>
        We produce events and build international collaborations, bringing together
        artists and promoters across cities and cultures to create distinctive dance
        floor experiences.
      </p>
    </div>

    <div class="about-meta">
      <div class="meta-item">
        <p class="meta-label">Residency</p>
        <p class="meta-value">Wednesdays</p>
      </div>
      <div class="meta-item">
        <p class="meta-label">Venue</p>
        <p class="meta-value">Rūmu, Lisbon</p>
      </div>
      <div class="meta-item">
        <p class="meta-label">Since</p>
        <p class="meta-value">2014</p>
      </div>
      <div class="meta-item">
        <p class="meta-label">Tickets</p>
        <p class="meta-value">Shotgun</p>
      </div>
    </div>

    <div class="roster-marquee" aria-label="Resident DJs">
      <div class="roster-track">
        {[...artists, ...artists].map((a) => (
          <a href={`/artists/${a.slug}`} class="roster-item">{a.data.name}</a>
        ))}
      </div>
    </div>

    <div class="about-cta">
      <a href="/artists" class="hero-cta">Meet the Artists →</a>
      <a href="/events" class="hero-cta secondary">View Events →</a>
    </div>
  </section>

  <Marquee />
</BaseLayout>

<style>
  .about-section {
    padding: 140px 48px 96px;
    max-width: 980px;
    margin: 0 auto;
  }
  .section-header { margin-bottom: 48px; }
  .section-label {
    font-family: theme('fontFamily.mono');
    font-size: 9px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: theme('colors.accent.DEFAULT');
    margin-bottom: 12px;
  }
  .about-section h1 {
    font-size: clamp(40px, 6vw, 84px);
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1;
    max-width: 800px;
  }
  .about-body {
    font-size: clamp(17px, 1.5vw, 22px);
    color: theme('colors.text.DEFAULT');
    line-height: 1.6;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 64px;
  }
  .about-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid theme('colors.border');
    border-bottom: 1px solid theme('colors.border');
    margin-bottom: 64px;
  }
  .meta-label {
    font-family: theme('fontFamily.mono');
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: theme('colors.text.muted');
    margin-bottom: 6px;
  }
  .meta-value {
    font-family: theme('fontFamily.mono');
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: theme('colors.text.DEFAULT');
  }

  .roster-marquee {
    overflow: hidden;
    margin: 0 -48px 64px;
    padding: 24px 0;
    border-top: 1px solid theme('colors.border');
    border-bottom: 1px solid theme('colors.border');
  }
  .roster-track {
    display: flex;
    gap: 64px;
    width: max-content;
    animation: marquee 22s linear infinite;
  }
  .roster-item {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -1px;
    color: theme('colors.text.muted');
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .roster-item:hover { color: theme('colors.accent.DEFAULT'); }

  .about-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 36px;
    background: theme('colors.accent.DEFAULT');
    color: theme('colors.bg.DEFAULT');
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.2s;
  }
  .hero-cta:hover { background: theme('colors.accent.hover'); transform: translateY(-2px); }
  .hero-cta.secondary {
    background: transparent;
    color: theme('colors.text.DEFAULT');
    border: 1px solid theme('colors.border');
  }
  .hero-cta.secondary:hover {
    border-color: theme('colors.accent.DEFAULT');
    color: theme('colors.accent.DEFAULT');
    background: transparent;
  }

  @media (max-width: 700px) {
    .about-section { padding: 100px 24px 64px; }
    .about-meta { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .roster-marquee { margin: 0 -24px 48px; }
  }
</style>
