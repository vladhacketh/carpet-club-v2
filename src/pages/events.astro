---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Marquee from '~/components/Marquee.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('events');
const upcoming = all
  .filter((e) => e.data.status === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const past = all
  .filter((e) => e.data.status === 'past')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmtDateLong = (d: Date) =>
  d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit' }).toUpperCase();
const fmtMonth = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toUpperCase();
const fmtDateShort = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit' }).toUpperCase();

// JSON-LD Event schema for upcoming
const events_schema = {
  '@context': 'https://schema.org',
  '@graph': upcoming.map((e) => ({
    '@type': 'Event',
    name: e.data.title,
    startDate: e.data.date.toISOString(),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: e.data.venue,
      address: { '@type': 'PostalAddress', addressLocality: 'Lisbon', addressCountry: 'PT' },
    },
    performer: e.data.lineup.map((name) => ({ '@type': 'PerformingGroup', name })),
    organizer: { '@type': 'Organization', name: 'Carpet Club', url: 'https://carpetclub.example' },
    ...(e.data.shotgun && { offers: { '@type': 'Offer', url: e.data.shotgun, availability: 'https://schema.org/InStock' } }),
  })),
};
---

<BaseLayout
  title="Events"
  description="Upcoming Wednesday events at Rūmu and past residency archive. Tickets on Shotgun."
  schema={events_schema}
>
  <section class="events-section">
    <header class="section-header">
      <p class="section-label">Wednesday Residency</p>
      <h1>Events</h1>
      <p class="lede">
        Every Wednesday at Rūmu, Lisbon. Tickets and lineups on Shotgun.
      </p>
    </header>

    {upcoming.length > 0 && (
      <div class="block">
        <h2>May 2026 · Upcoming</h2>
        <div class="event-grid">
          {upcoming.map((e) => (
            <article class="event-card">
              <time datetime={e.data.date.toISOString()} class="event-date">
                {fmtDateLong(e.data.date)}
              </time>
              <h3>{e.data.title}</h3>
              <p class="lineup">{e.data.lineup.join(' · ')}</p>
              <p class="venue">{e.data.venue}, Lisbon</p>
              {e.data.shotgun && (
                <a href={e.data.shotgun} target="_blank" rel="noopener noreferrer" class="event-cta">
                  Tickets on Shotgun →
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    )}

    {past.length > 0 && (
      <div class="block past-block">
        <h2>Past Residency</h2>
        <div class="past-table">
          {past.map((e) => (
            <article class="past-row">
              <time datetime={e.data.date.toISOString()} class="past-date">
                {fmtMonth(e.data.date)} · {fmtDateShort(e.data.date).split(' ')[1]}
              </time>
              <div class="past-info">
                <p class="past-title">{e.data.title}</p>
                <p class="past-lineup">{e.data.lineup.join(' · ')}</p>
              </div>
              <p class="past-venue">{e.data.venue}</p>
            </article>
          ))}
        </div>
        <a
          href="https://shotgun.live/en/venues/carpet-snares-records"
          target="_blank"
          rel="noopener noreferrer"
          class="more-past"
        >
          More Past Residency on Shotgun →
        </a>
      </div>
    )}

    <div class="block showcases-block">
      <p class="section-label">Special Events</p>
      <h2>Showcases</h2>
      <p class="showcases-lede">
        Special events at different venues — Lisbon and beyond. Label nights, one-off
        collaborations, and curated experiences with guests from the international circuit.
      </p>
      <div class="showcases-links">
        <a href="https://ra.co/promoters/55088" target="_blank" rel="noopener noreferrer">Resident Advisor →</a>
        <a href="https://shotgun.live/en/venues/carpet-snares-records" target="_blank" rel="noopener noreferrer">Shotgun →</a>
        <a href="https://instagram.com/carpetclub_/" target="_blank" rel="noopener noreferrer">Instagram →</a>
      </div>
    </div>
  </section>

  <Marquee />
</BaseLayout>

<style>
  .events-section {
    padding: 140px 48px 96px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-header { margin-bottom: 64px; max-width: 720px; }
  .section-label {
    font-family: theme('fontFamily.mono');
    font-size: 9px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: theme('colors.accent.DEFAULT');
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1;
    margin-bottom: 24px;
  }
  .lede {
    color: theme('colors.text.muted');
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
  }

  .block { margin-bottom: 96px; }
  .block h2 {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    letter-spacing: -1px;
    margin-bottom: 32px;
  }

  /* Upcoming grid */
  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .event-card {
    background: theme('colors.bg.card');
    border: 1px solid theme('colors.border');
    padding: 28px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .event-card:hover {
    border-color: theme('colors.accent.DEFAULT');
    transform: translateY(-2px);
  }
  .event-date {
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    letter-spacing: 3px;
    color: theme('colors.accent.DEFAULT');
    display: block;
    margin-bottom: 16px;
  }
  .event-card h3 {
    font-size: 22px;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }
  .lineup { color: theme('colors.text.muted'); margin-bottom: 4px; }
  .venue {
    font-family: theme('fontFamily.mono');
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: theme('colors.text.muted');
    margin-bottom: 20px;
  }
  .event-cta {
    font-family: theme('fontFamily.mono');
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    color: theme('colors.accent.DEFAULT');
    transition: color 0.2s;
  }
  .event-cta:hover { color: theme('colors.accent.hover'); }

  /* Past table */
  .past-table {
    max-width: 880px;
    border-top: 1px solid theme('colors.border');
  }
  .past-row {
    display: grid;
    grid-template-columns: 140px 1fr 200px;
    gap: 32px;
    padding: 20px 0;
    border-bottom: 1px solid theme('colors.border');
    align-items: center;
  }
  .past-date {
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    letter-spacing: 2px;
    color: theme('colors.accent.DEFAULT');
  }
  .past-title {
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 2px;
  }
  .past-lineup {
    color: theme('colors.text.muted');
    font-size: 14px;
  }
  .past-venue {
    font-family: theme('fontFamily.mono');
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: theme('colors.text.muted');
    text-align: right;
  }
  .more-past {
    display: inline-block;
    margin-top: 24px;
    padding: 12px 28px;
    border: 1px solid theme('colors.border');
    color: theme('colors.text.DEFAULT');
    text-decoration: none;
    font-family: theme('fontFamily.mono');
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition: all 0.2s;
    border-radius: 2px;
  }
  .more-past:hover {
    border-color: theme('colors.accent.DEFAULT');
    color: theme('colors.accent.DEFAULT');
  }

  /* Showcases */
  .showcases-block { margin-bottom: 0; }
  .showcases-lede {
    color: theme('colors.text.muted');
    font-size: 16px;
    line-height: 1.7;
    max-width: 720px;
    margin-bottom: 24px;
  }
  .showcases-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .showcases-links a {
    color: theme('colors.accent.DEFAULT');
    text-decoration: none;
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .showcases-links a:hover { color: theme('colors.accent.hover'); }

  @media (max-width: 700px) {
    .events-section { padding: 100px 24px 64px; }
    .past-row { grid-template-columns: 100px 1fr; }
    .past-venue { grid-column: 1 / -1; text-align: left; padding-left: 0; }
  }
</style>
