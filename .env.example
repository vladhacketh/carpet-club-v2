# Copy to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Web3Forms access key (forms backend).
# Sign up at https://web3forms.com/ — get a key by entering your email.
# Free tier: 250 submissions/month, no account needed.
PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Meta Conversions API (server-side event mirror of the Pixel).
# Generate in Events Manager → Settings → Conversions API → "Generate access token".
# Server-only — never starts with PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# Optional: paste a test event code from Events Manager → Test events while
# verifying. Remove from prod env once verified to count real events again.
META_CAPI_TEST_EVENT_CODE=
