---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Marquee from '~/components/Marquee.astro';
import { getCollection } from 'astro:content';

const artists = await getCollection('artists');
---

<BaseLayout
  title="About"
  description="Carpet Club is a Lisbon-based event brand. Weekly events and curated showcases rooted in electronic music and club culture, part of the Carpet & Snares ecosystem (est. 2014)."
>
  <section class="about-section">
    <header class="section-header">
      <p class="section-label">Who We Are</p>
    </header>

    <div class="about-body">
      <p>
        Carpet Club is a Lisbon-based event brand running weekly nights and curated
        showcases rooted in electronic music club culture — part of the Carpet &amp; Snares
        ecosystem (est. 2014).
      </p>
      <p class="muted">
        We produce events, build international collaborations, and bring together
        artists, promoters, cities, and cultures to create distinctive dance floor
        experiences.
      </p>
    </div>

    <p class="section-label roster-label">Roster</p>
    <div class="roster-marquee" aria-label="Resident DJs">
      <div class="roster-track">
        {[...artists, ...artists].map((a) => (
          <>
            <a href={`/artists/${a.slug}`} class="roster-item">{a.data.name}</a>
            <span class="roster-sep" aria-hidden="true">•</span>
          </>
        ))}
      </div>
    </div>

    <div class="about-cta">
      <a href="/artists" class="hero-cta">Our Artists →</a>
      <a href="/events" class="hero-cta secondary">View Events →</a>
    </div>
  </section>

  <Marquee />
</BaseLayout>

<style>
  .about-section {
    padding: 140px 48px 96px;
    max-width: 980px;
    margin: 0 auto;
  }
  .section-header { margin-bottom: 32px; }
  .section-label {
    font-family: theme('fontFamily.mono');
    font-size: 9px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: theme('colors.accent.DEFAULT');
  }
  .about-body {
    font-size: clamp(17px, 1.5vw, 22px);
    color: theme('colors.text.DEFAULT');
    line-height: 1.6;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 64px;
  }
  .about-body .muted { color: theme('colors.text.muted'); }
  .roster-label { margin-bottom: 16px; }
  .roster-marquee {
    overflow: hidden;
    margin: 0 -48px 64px;
    padding: 20px 0;
    border-top: 1px solid theme('colors.border');
    border-bottom: 1px solid theme('colors.border');
  }
  .roster-track {
    display: flex;
    align-items: center;
    gap: 24px;
    width: max-content;
    animation: marquee 22s linear infinite;
  }
  .roster-item {
    font-family: theme('fontFamily.mono');
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: theme('colors.text.DEFAULT');
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .roster-item:hover { color: theme('colors.accent.DEFAULT'); }
  .roster-sep {
    color: theme('colors.accent.DEFAULT');
    font-size: 14px;
    line-height: 1;
  }

  .about-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 36px;
    background: theme('colors.accent.DEFAULT');
    color: theme('colors.bg.DEFAULT');
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.2s;
  }
  .hero-cta:hover { background: theme('colors.accent.hover'); transform: translateY(-2px); }
  .hero-cta.secondary {
    background: transparent;
    color: theme('colors.text.DEFAULT');
    border: 1px solid theme('colors.border');
  }
  .hero-cta.secondary:hover {
    border-color: theme('colors.accent.DEFAULT');
    color: theme('colors.accent.DEFAULT');
    background: transparent;
  }

  @media (max-width: 700px) {
    .about-section { padding: 100px 24px 64px; }
    .roster-marquee { margin: 0 -24px 48px; }
  }
</style>
